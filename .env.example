# ============================================================
# HORIZONTE — configuração local (copie para .env e preencha)
# Este arquivo .env NUNCA vai para o Git (está no .gitignore).
# ============================================================

# --- LinkedIn (app gratuito em https://www.linkedin.com/developers/apps) ---
# Produtos do app: "Share on LinkedIn" e "Sign In with LinkedIn using OpenID Connect".
# Em "Auth", cadastre exatamente este endereço de retorno:
#   http://localhost:8787/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=http://localhost:8787/api/linkedin/callback
# Versão da API (AAAAMM). Deixe vazio: o HORIZONTE escolhe e ajusta sozinho.
LINKEDIN_API_VERSION=

# --- IA local (Ollama, gratuito) ---
OLLAMA_URL=http://127.0.0.1:11434
# Para placa de vídeo de 16 GB, gemma4:12b é um bom equilíbrio. Alternativas: qwen3:14b, gemma3:27b (mais lento).
OLLAMA_MODEL=gemma4:12b

# --- Painel ---
# Chave para entrar no painel. Se ficar vazia, o HORIZONTE cria uma e grava em data/admin.token.
HORIZONTE_ADMIN_TOKEN=
# Chave que criptografa o token do LinkedIn. Se ficar vazia, é criada em data/secret.key.
# Para gerar uma: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HORIZONTE_SECRET_KEY=
HORIZONTE_PORT=8787
# 127.0.0.1 = só este computador. Use 0.0.0.0 apenas se quiser abrir pelo celular na mesma rede.
HORIZONTE_HOST=127.0.0.1
HORIZONTE_TIMEZONE=America/Belem
# HORIZONTE_DATA_DIR=data
